# Copie este archivo a .env y complete los valores.

MONGODB_URI=mongodb+srv://usuario:clave@cluster.mongodb.net/mesa-de-ayuda?retryWrites=true&w=majority

# Cadena aleatoria larga para firmar tokens JWT (cambie en producción)
JWT_SECRET=cambie_esto_por_un_secreto_largo_y_aleatorio

# Puerto del servidor Express (opcional)
PORT=3000
